# Copy to backend/.env and fill in. Nothing here is needed to run the test
# suite -- `pytest` is fully offline.

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
EXTRACTION_MODEL=claude-opus-5

# --- Airtable ----------------------------------------------------------
# Personal access token with schema.bases:write (to provision) and
# data.records:read/write scopes.
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...

# --- Webhook auth ------------------------------------------------------
# Shared with the Zapier Code step. Generate: openssl rand -hex 32
WEBHOOK_SECRET=
# Local dev only -- skips signature verification entirely.
ALLOW_UNSIGNED_WEBHOOKS=false

# --- Thresholds --------------------------------------------------------
MATCH_AUTO_APPLY_THRESHOLD=0.90
EXTRACTION_CONFIDENCE_THRESHOLD=0.80
# Deliberately off. A misread cancellation kills a live bid unrecoverably.
ENABLE_AUTO_CANCELLATION=false

# --- Frontend ----------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated origins allowed to call the API. Must include wherever the
# dashboard is actually served from.
CORS_ORIGINS=http://localhost:3000

# --- Demo --------------------------------------------------------------
# Serves a seeded in-memory base instead of Airtable, so the dashboard can be
# demonstrated and recorded without credentials. Reported by /health.
DEMO_MODE=false
